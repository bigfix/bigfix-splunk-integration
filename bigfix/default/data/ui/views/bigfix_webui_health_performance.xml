<dashboard version="1.1" theme="dark">
  <label>BigFix WebUI Health Overview</label>
  <description>Monitoring for WebUI Service Crashes, API Connectivity, and File Permission Errors</description>
  
  <fieldset submitButton="false">
    <input type="time" token="global_time">
      <label>Time Range</label>
      <default>
        <earliest>-7d@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <row>
   <panel>
      <title>WebUI Service Status (Last Known)</title>
      <single>
        <search>
          <query>index=bigfix sourcetype="bigfix:webui" ("process started" OR "Stopping WebUI service app" OR "process exited") 
| head 1 
| eval Status=if(searchmatch("process started"), "UP", "DOWN / CRASHED") 
| table Status</query>
          <earliest>0</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webui" ("process started" OR "Stopping WebUI service app" OR "process exited")&amp;earliest=0&amp;latest=$global_time.latest$</link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <title>Process Crashes</title>
      <single>
        <search>
          <query>index=bigfix sourcetype="bigfix:webui" "process exited with code" | stats count</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webui" "process exited with code"&amp;earliest=$global_time.earliest$&amp;latest=$global_time.latest$</link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <title>File Access Denied Errors</title>
      <single>
        <search>
          <query>index=bigfix sourcetype="bigfix:webui" "FilePermissionError" | stats count</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[0,5]</option>
        <option name="drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webui" "FilePermissionError"&amp;earliest=$global_time.earliest$&amp;latest=$global_time.latest$</link>
        </drilldown>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>WebUI Process Crashes Over Time</title>
      <chart>
        <search>
          <query>index=bigfix sourcetype="bigfix:webui" "process exited with code" 
| rex field=_raw "process exited with code (?&lt;exit_code&gt;\d+)" 
| timechart count by exit_code</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webui" "process exited with code $click.name2$"&amp;earliest=$earliest$&amp;latest=$latest$</link>
        </drilldown>
      </chart>
    </panel>
    <panel>
      <title>Root Server API Connection Errors</title>
      <chart>
        <search>
          <query>index=bigfix sourcetype="bigfix:webui" "HTTP Error"
| rex field=_raw "HTTP Error (?&lt;http_error_code&gt;\d+):\s+(?&lt;error_message&gt;[^\:]+)"
| eval Error_Type="HTTP Error " + http_error_code
| stats count by Error_Type</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
       <option name="charting.drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webui" "$click.value$"&amp;earliest=$global_time.earliest$&amp;latest=$global_time.latest$</link>
        </drilldown>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Cascading Database Failures (HTTP 503)</title>
      <chart>
        <search>
          <query>index=bigfix sourcetype="bigfix:webui" ("Unexpected HTTP response: 503" OR "request failed with status 503")
| timechart count span=1h</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.fieldColors">{"count": 0xDC4E41}</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webui" ("Unexpected HTTP response: 503" OR "request failed with status 503")&amp;earliest=$earliest$&amp;latest=$latest$</link>
        </drilldown>
      </chart>
    </panel>
  </row>
</dashboard>