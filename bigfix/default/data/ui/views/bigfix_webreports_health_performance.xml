<dashboard version="1.1" theme="dark">
  <label>BigFix Web Reports Health Overview</label>
  <description>Monitoring for Database Connectivity, External Site Sync, API Health, and Service Status</description>

  <fieldset submitButton="false">
    <input type="time" token="global_time">
      <label>Time Range</label>
      <default>
        <earliest>-7d@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <row>
    <panel>
      <title>Web Reports Service Status (Last Known)</title>
      <single>
        <search>
          <query>index=bigfix sourcetype="bigfix:webreports" ("Initializing Web Reports" OR "Web Reports is shutting down")
| head 1
| eval Status=if(searchmatch("shutting down"), "DOWN", "UP")
| table Status</query>
          <earliest>0</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webreports" ("Initializing Web Reports" OR "Web Reports is shutting down")&amp;earliest=0&amp;latest=$global_time.latest$</link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <title>Database Connection Errors</title>
      <single>
        <search>
          <query>index=bigfix sourcetype="bigfix:webreports" "Database Error:" | stats count</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[0,10]</option>
        <option name="drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webreports" "Database Error:"&amp;earliest=$global_time.earliest$&amp;latest=$global_time.latest$</link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <title>SSL / Certificate Errors</title>
      <single>
        <search>
          <query>index=bigfix sourcetype="bigfix:webreports" ("SSL peer certificate" OR "SSL_write_Failed") | stats count</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webreports" ("SSL peer certificate" OR "SSL_write_Failed")&amp;earliest=$global_time.earliest$&amp;latest=$global_time.latest$</link>
        </drilldown>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Database Errors Over Time</title>
      <chart>
        <search>
          <query>index=bigfix sourcetype="bigfix:webreports" "Database Error:"
| rex field=_raw "\[Microsoft\]\[ODBC Driver 18 for SQL Server\](?&lt;sql_error&gt;[^\(\n]+)"
| eval sql_error=trim(sql_error)
| timechart count by sql_error</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">all</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webreports" "Database Error:" "$click.name2$"&amp;earliest=$earliest$&amp;latest=$latest$</link>
        </drilldown>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Root Server API Errors</title>
      <table>
        <search>
          <query>index=bigfix sourcetype="bigfix:webreports" "Retrying RequestServerData" "HTTP Error"
| rex field=_raw "RequestServerData \((?&lt;HTTP_Method&gt;[A-Z]+)\s+(?&lt;API_URL&gt;.*?)\):\s+(?&lt;Error_Message&gt;HTTP Error.*)"
| table _time, HTTP_Method, API_URL, Error_Message
| sort - _time</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="drilldown">row</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webreports" "Retrying RequestServerData" "$row.API_URL$" "$row.Error_Message$"&amp;earliest=$earliest$&amp;latest=$latest$</link>
        </drilldown>
      </table>
    </panel>
    <panel>
      <title>External Site Sync Errors</title>
      <table>
        <search>
          <query>index=bigfix sourcetype="bigfix:webreports" "A curl error occurred contacting the server for site"
| rex field=_raw "site='(?&lt;Site_Name&gt;[^']+)'(?:;error=)?(?&lt;Error_Message&gt;.*)"
| table _time, Site_Name, Error_Message
| sort - _time</query>
          <earliest>$global_time.earliest$</earliest>
          <latest>$global_time.latest$</latest>
        </search>
        <option name="drilldown">row</option>
        <drilldown>
          <link target="_blank">search?q=index=bigfix sourcetype="bigfix:webreports" "A curl error occurred contacting the server for site" "$row.Site_Name$" "$row.Error_Message$"&amp;earliest=$earliest$&amp;latest=$latest$</link>
        </drilldown>
      </table>
    </panel>
  </row>
</dashboard>